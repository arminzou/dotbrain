{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "dotbrain hook session-start",
            "timeout": 15,
            "statusMessage": "Loading Brain context"
          }
        ]
      }
    ]
  }
}
